# ---------------------------------------------------------------------------
# Provedor de LLM (qualquer endpoint OpenAI-compatible)
# ---------------------------------------------------------------------------
# Groq (grátis, sem cartão): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=moonshotai/kimi-k2-instruct
LLM_API_KEY=

# Alternativas (basta trocar as três linhas acima):
#   Cerebras     https://api.cerebras.ai/v1                 llama3.1-70b
#   OpenRouter   https://openrouter.ai/api/v1               nvidia/nemotron-3-ultra-550b-a55b:free
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai/
#                gemini-3.6-flash   (e LLM_AUTH_HEADER=Authorization)
#   Ollama local http://localhost:11434/v1                  llama3.3  (api key=ollama)

LLM_TEMPERATURE=0.75
LLM_MAX_TOKENS=4000

# ---------------------------------------------------------------------------
# Recuperação (RAG)
# ---------------------------------------------------------------------------
# keyword (padrão, offline) | embedding | hybrid
RETRIEVAL_MODE=keyword
RETRIEVAL_TOP_K=8
CHUNK_CHARS=1400
CHUNK_OVERLAP=200

# Só necessário para RETRIEVAL_MODE=embedding|hybrid, ou ingest --embeddings
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Comportamento
# ---------------------------------------------------------------------------
MOSTRAR_GRAUS=1
MAX_HISTORICO=8
